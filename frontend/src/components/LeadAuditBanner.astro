---
---

<section id="auditoria" class="py-12 md:py-16 bg-amber-300 border-b-2 border-zinc-900 text-zinc-900 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="p-5 sm:p-12 bg-white rounded-3xl border-3 border-zinc-900 shadow-brutal-lg relative">
      
      <!-- Top Decorative Sticker -->
      <div class="absolute -top-4 right-8 hidden sm:inline-block">
        <span class="px-4 py-1.5 rounded-full bg-zinc-900 text-amber-300 text-xs font-black uppercase tracking-widest border-2 border-zinc-900 shadow-brutal-sm -rotate-2 inline-block">
          ⚡ 100% Sin Costo
        </span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <!-- Left Text (7 cols) -->
        <div class="lg:col-span-7 space-y-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-50 border-2 border-indigo-200 text-xs font-black text-indigo-700 uppercase tracking-wider">
            <span>🔍</span> Diagnóstico Técnico de Rendimiento
          </div>
          
          <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight font-display text-zinc-900 leading-tight">
            Auditoría gratuita de velocidad, SEO y seguridad de tu web actual en 24h.
          </h2>
          
          <p class="text-sm sm:text-base text-zinc-600 font-medium leading-relaxed">
            ¿Tu sitio web tarda más de 2.5 segundos en abrir en el celular o pierdes clientes en Google? Analizamos tus <strong>Core Web Vitals</strong>, certificados SSL, código y cuellos de botella para enviarte un reporte técnico claro y aplicable.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2 text-xs font-bold text-zinc-700">
            <span class="flex items-center gap-1.5">
              <span class="text-emerald-600 font-black">✓</span> Métricas Google PageSpeed
            </span>
            <span class="flex items-center gap-1.5">
              <span class="text-emerald-600 font-black">✓</span> Revisión SEO on-page
            </span>
            <span class="flex items-center gap-1.5">
              <span class="text-emerald-600 font-black">✓</span> Chequeo de seguridad SSL/HTTP
            </span>
          </div>
        </div>

        <!-- Right Form (5 cols) -->
        <div class="lg:col-span-5 bg-zinc-50 p-5 sm:p-6 rounded-2xl border-2 border-zinc-900 shadow-brutal">
          
          <form id="audit-form" class="space-y-4" novalidate>
            <div>
              <label for="audit-url" class="block text-xs font-extrabold uppercase tracking-wider text-zinc-800 mb-1">
                Dirección de tu sitio web <span class="text-red-600">*</span>
              </label>
              <input 
                type="url" 
                id="audit-url" 
                required 
                placeholder="https://tuempresa.com" 
                class="w-full px-4 py-3 rounded-xl bg-white border-2 border-zinc-900 text-zinc-900 placeholder-zinc-400 text-base sm:text-sm font-medium focus:outline-none focus:ring-2 focus:ring-zinc-900 transition-colors"
              />
            </div>

            <div>
              <label for="audit-contact" class="block text-xs font-extrabold uppercase tracking-wider text-zinc-800 mb-1">
                ¿Dónde te enviamos el informe? <span class="text-red-600">*</span>
              </label>
              <input 
                type="text" 
                id="audit-contact" 
                required 
                placeholder="Tu correo o WhatsApp (+51...)" 
                class="w-full px-4 py-3 rounded-xl bg-white border-2 border-zinc-900 text-zinc-900 placeholder-zinc-400 text-base sm:text-sm font-medium focus:outline-none focus:ring-2 focus:ring-zinc-900 transition-colors"
              />
            </div>

            <button 
              type="submit" 
              class="w-full py-3.5 px-6 rounded-full text-xs sm:text-sm uppercase tracking-wider font-extrabold text-white bg-zinc-900 hover:bg-indigo-600 border-2 border-zinc-900 shadow-brutal-sm hover:shadow-brutal transition-all duration-150 flex items-center justify-center gap-2"
            >
              <span>Solicitar Auditoría Gratuita</span>
              <span class="text-amber-300 font-bold">⚡</span>
            </button>

            <p class="text-[10px] text-zinc-500 text-center font-medium">
              Reporte confidencial generado por nuestros ingenieros sin spam ni costos ocultos.
            </p>
          </form>

          <!-- Success Alert -->
          <div id="audit-success" class="hidden text-center py-6 space-y-3">
            <div class="w-12 h-12 mx-auto rounded-full bg-emerald-100 border-2 border-emerald-600 flex items-center justify-center text-emerald-600 font-black text-xl">
              ✓
            </div>
            <h4 class="text-lg font-extrabold text-zinc-900 font-display">¡Solicitud recibida con éxito!</h4>
            <p class="text-xs text-zinc-600 font-medium">
              Nuestro equipo técnico está evaluando tu sitio web. Te entregaremos el informe en menos de 24 horas hábiles.
            </p>
            <a 
              id="audit-wa-direct" 
              href="#" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-emerald-600 text-white text-xs font-extrabold border-2 border-zinc-900 shadow-brutal-sm hover:bg-emerald-500 transition-colors"
            >
              <span>Acelerar revisión por WhatsApp</span>
              <span>💬</span>
            </a>
          </div>

        </div>

      </div>

    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('audit-form');
    const successBox = document.getElementById('audit-success');
    const waDirectLink = document.getElementById('audit-wa-direct');

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const urlInput = document.getElementById('audit-url');
        const contactInput = document.getElementById('audit-contact');

        const webUrl = urlInput ? urlInput.value.trim() : '';
        const contact = contactInput ? contactInput.value.trim() : '';

        if (!webUrl || !contact) {
          alert('Por favor ingresa la URL de tu web y tu contacto.');
          return;
        }

        const msg = `¡Hola MolinazDev! 👋 Solicité la Auditoría Gratuita de 24h para mi web:\n\n` +
                    `🌐 *Sitio Web:* ${webUrl}\n` +
                    `📬 *Contacto:* ${contact}\n\n` +
                    `Quedo a la espera del reporte de velocidad y SEO. ¡Muchas gracias!`;

        if (waDirectLink) {
          waDirectLink.href = `https://wa.me/51987654321?text=${encodeURIComponent(msg)}`;
        }

        form.classList.add('hidden');
        if (successBox) {
          successBox.classList.remove('hidden');
        }
      });
    }
  });
</script>
