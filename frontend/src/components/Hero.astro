---
---

<section class="relative pt-32 pb-20 md:pt-44 md:pb-32 overflow-hidden mesh-gradient">
  <!-- Glowing Background Orbs -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-indigo-600/15 blur-[120px] rounded-full pointer-events-none -z-10"></div>
  <div class="absolute top-1/3 left-1/4 w-[350px] h-[350px] bg-blue-600/10 blur-[100px] rounded-full pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-4xl mx-auto space-y-8">
      
      <!-- Pill Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full glass-card border-indigo-500/30 text-xs sm:text-sm font-medium text-indigo-300 shadow-glow-sm">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-500"></span>
        </span>
        Tecnología de Alto Nivel &bull; Cotización y Pago Inmediato
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white font-display leading-[1.08]">
        Construimos la solución <br class="hidden sm:inline" />
        <span class="text-gradient-primary">digital y automatizada</span> <br class="hidden sm:inline" />
        que tu empresa necesita.
      </h1>

      <!-- Subtitle -->
      <p class="text-lg sm:text-xl text-zinc-400 max-w-2xl mx-auto font-normal leading-relaxed">
        Sitios web de alto impacto, asistentes inteligentes con IA, automatizaciones operativas y software a medida. Alcance y precio definidos desde el primer minuto.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
        <a 
          href="#servicios" 
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-full text-sm font-semibold text-white bg-gradient-to-r from-indigo-600 via-indigo-500 to-blue-600 hover:from-indigo-500 hover:to-blue-500 transition-all duration-300 shadow-glow-md hover:shadow-glow-lg hover:-translate-y-0.5"
        >
          <span>Elegir un Paquete</span>
          <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        
        <a 
          href="#proceso" 
          class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-full text-sm font-semibold text-zinc-300 hover:text-white glass-card hover:bg-zinc-800/80 transition-all duration-300 border-zinc-700/60"
        >
          Cómo Trabajamos
        </a>
      </div>

      <!-- Trust Metrics & Badges -->
      <div class="pt-12 grid grid-cols-2 md:grid-cols-4 gap-6 border-t border-zinc-800/80 max-w-3xl mx-auto">
        <div class="flex flex-col items-center">
          <span class="text-2xl sm:text-3xl font-extrabold text-white font-display">100%</span>
          <span class="text-xs text-zinc-400 mt-1">Precio Transparente</span>
        </div>
        <div class="flex flex-col items-center">
          <span class="text-2xl sm:text-3xl font-extrabold text-white font-display">10-60d</span>
          <span class="text-xs text-zinc-400 mt-1">Plazo de Entrega</span>
        </div>
        <div class="flex flex-col items-center">
          <span class="text-2xl sm:text-3xl font-extrabold text-white font-display">24/7</span>
          <span class="text-xs text-zinc-400 mt-1">Chatbots con IA</span>
        </div>
        <div class="flex flex-col items-center">
          <span class="text-2xl sm:text-3xl font-extrabold text-white font-display">Seguro</span>
          <span class="text-xs text-zinc-400 mt-1">Mercado Pago Pro</span>
        </div>
      </div>

    </div>
  </div>
</section>
