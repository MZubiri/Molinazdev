---
---

<section id="portafolio-resumen" class="py-14 sm:py-20 bg-zinc-50 border-b-2 border-zinc-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Index & Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div class="max-w-2xl space-y-2 text-center md:text-left">
        <div class="text-xs font-extrabold tracking-widest text-zinc-500 uppercase">
          03 / CASOS DE ÉXITO
        </div>
        <h2 class="text-3xl sm:text-5xl font-extrabold text-zinc-900 font-display leading-[1.12]">
          Proyectos Que Convierten Visitas en Clientes
        </h2>
        <p class="text-sm sm:text-base text-zinc-600 font-medium">
          Soluciones reales con código limpio, arquitectura escalable y tiempos de carga inferiores a 1 segundo.
        </p>
      </div>

      <div class="flex justify-center md:justify-end">
        <a 
          href="/portafolio/" 
          class="inline-flex items-center gap-2 px-5 py-3 rounded-full text-xs uppercase tracking-wider font-extrabold bg-zinc-900 text-white hover:bg-emerald-600 border-2 border-zinc-900 shadow-brutal hover:shadow-brutal-lg transition-all"
        >
          <span>Ver Portafolio Completo</span>
          <span class="text-base">↗</span>
        </a>
      </div>
    </div>

    <!-- 2 Featured Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      
      <!-- Project 1: E-Commerce -->
      <div class="bg-white rounded-3xl border-3 border-zinc-900 shadow-brutal overflow-hidden flex flex-col group hover:-translate-y-1 hover:shadow-brutal-lg transition-all duration-200">
        <!-- Mock Browser Header -->
        <div class="px-4 py-3 bg-zinc-900 border-b-2 border-zinc-900 flex items-center justify-between">
          <div class="flex items-center gap-1.5">
            <span class="w-3 h-3 rounded-full bg-red-500 inline-block border border-zinc-900"></span>
            <span class="w-3 h-3 rounded-full bg-amber-400 inline-block border border-zinc-900"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-400 inline-block border border-zinc-900"></span>
          </div>
          <span class="text-[11px] font-mono text-zinc-400 font-semibold truncate">tienda-demo.molinazdev.lat</span>
          <span class="text-zinc-500 text-xs">🔒</span>
        </div>

        <!-- Banner Visual -->
        <div class="h-44 sm:h-48 bg-gradient-to-br from-indigo-600 via-indigo-700 to-zinc-900 p-6 flex flex-col justify-end text-white relative overflow-hidden">
          <div class="absolute inset-0 opacity-15 bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:16px_16px]"></div>
          <span class="inline-block px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-[10px] font-extrabold uppercase tracking-wider text-white border border-white/30 w-fit mb-1.5">
            E-Commerce &middot; Retail &amp; Moda
          </span>
          <h3 class="text-xl font-black font-display leading-tight text-white drop-shadow">
            Plataforma E-Commerce Ultrarrápida
          </h3>
        </div>

        <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
          <div class="space-y-3">
            <p class="text-xs sm:text-sm text-zinc-600 font-medium leading-relaxed">
              Catálogo sincronizado, pasarela Mercado Pago integrada, checkout optimizado para móviles y panel de inventario en tiempo real.
            </p>
            
            <div class="p-3 rounded-xl bg-emerald-50 border border-emerald-300 flex items-center justify-between text-xs font-bold text-emerald-900">
              <span>🚀 Rendimiento en Celulares:</span>
              <span class="font-extrabold text-emerald-700">0.8s LCP (Score 98)</span>
            </div>
          </div>

          <div class="pt-3 border-t border-zinc-200 flex items-center justify-between">
            <div class="flex flex-wrap gap-1 text-[10px] font-extrabold text-zinc-700 uppercase">
              <span class="px-2 py-0.5 bg-zinc-100 rounded border border-zinc-300">Astro</span>
              <span class="px-2 py-0.5 bg-zinc-100 rounded border border-zinc-300">.NET 8</span>
              <span class="px-2 py-0.5 bg-zinc-100 rounded border border-zinc-300">Mercado Pago</span>
            </div>
            <a href="/portafolio/" class="text-xs font-extrabold text-indigo-600 hover:text-indigo-800 flex items-center gap-1">
              Ver detalle ↗
            </a>
          </div>
        </div>
      </div>

      <!-- Project 2: AI WhatsApp Agent -->
      <div class="bg-white rounded-3xl border-3 border-zinc-900 shadow-brutal overflow-hidden flex flex-col group hover:-translate-y-1 hover:shadow-brutal-lg transition-all duration-200">
        <!-- Mock Browser Header -->
        <div class="px-4 py-3 bg-zinc-900 border-b-2 border-zinc-900 flex items-center justify-between">
          <div class="flex items-center gap-1.5">
            <span class="w-3 h-3 rounded-full bg-red-500 inline-block border border-zinc-900"></span>
            <span class="w-3 h-3 rounded-full bg-amber-400 inline-block border border-zinc-900"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-400 inline-block border border-zinc-900"></span>
          </div>
          <span class="text-[11px] font-mono text-zinc-400 font-semibold truncate">api-whatsapp.molinazdev.lat</span>
          <span class="text-zinc-500 text-xs">🤖</span>
        </div>

        <!-- Banner Visual -->
        <div class="h-44 sm:h-48 bg-gradient-to-br from-emerald-600 via-teal-700 to-zinc-900 p-6 flex flex-col justify-end text-white relative overflow-hidden">
          <div class="absolute inset-0 opacity-15 bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:16px_16px]"></div>
          <span class="inline-block px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-[10px] font-extrabold uppercase tracking-wider text-white border border-white/30 w-fit mb-1.5">
            Inteligencia Artificial &middot; WhatsApp API
          </span>
          <h3 class="text-xl font-black font-display leading-tight text-white drop-shadow">
            Agente IA de Agendamiento 24/7
          </h3>
        </div>

        <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
          <div class="space-y-3">
            <p class="text-xs sm:text-sm text-zinc-600 font-medium leading-relaxed">
              Bot conversacional en WhatsApp con LLM que responde preguntas técnicas, asesora sobre disponibilidad y agenda citas en tiempo real.
            </p>
            
            <div class="p-3 rounded-xl bg-emerald-50 border border-emerald-300 flex items-center justify-between text-xs font-bold text-emerald-900">
              <span>📈 Eficiencia Operativa:</span>
              <span class="font-extrabold text-emerald-700">+4,200 consultas/mes</span>
            </div>
          </div>

          <div class="pt-3 border-t border-zinc-200 flex items-center justify-between">
            <div class="flex flex-wrap gap-1 text-[10px] font-extrabold text-zinc-700 uppercase">
              <span class="px-2 py-0.5 bg-zinc-100 rounded border border-zinc-300">WhatsApp API</span>
              <span class="px-2 py-0.5 bg-zinc-100 rounded border border-zinc-300">OpenAI</span>
              <span class="px-2 py-0.5 bg-zinc-100 rounded border border-zinc-300">PostgreSQL</span>
            </div>
            <a href="/demo-ia/" class="text-xs font-extrabold text-emerald-700 hover:text-emerald-900 flex items-center gap-1">
              Probar simulador ⚡
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Action Button -->
    <div class="mt-10 text-center">
      <a 
        href="/portafolio/" 
        class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full text-xs uppercase tracking-wider font-extrabold bg-white text-zinc-900 hover:bg-zinc-900 hover:text-white border-2 border-zinc-900 shadow-brutal hover:shadow-brutal-lg transition-all"
      >
        <span>Explorar todos los casos de estudio en el Portafolio</span>
        <span class="text-base">💼</span>
      </a>
    </div>

  </div>
</section>
