---
---

<section id="portafolio-resumen" class="py-14 sm:py-20 bg-zinc-50 border-b-2 border-zinc-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Index & Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div class="max-w-2xl space-y-2 text-center md:text-left">
        <div class="text-xs font-extrabold tracking-widest text-zinc-500 uppercase">
          03 / CASOS DE ÉXITO
        </div>
        <h2 class="text-3xl sm:text-5xl font-extrabold text-zinc-900 font-display leading-[1.12]">
          Proyectos Que Convierten Visitas en Clientes
        </h2>
        <p class="text-sm sm:text-base text-zinc-600 font-medium">
          Soluciones reales con código limpio, arquitectura escalable y tiempos de carga inferiores a 1 segundo.
        </p>
      </div>

      <div class="flex justify-center md:justify-end">
        <a 
          href="/portafolio/" 
          class="inline-flex items-center gap-2 px-5 py-3 rounded-full text-xs uppercase tracking-wider font-extrabold bg-zinc-900 text-white hover:bg-emerald-600 border-2 border-zinc-900 shadow-brutal hover:shadow-brutal-lg transition-all"
        >
          <span>Ver Portafolio Completo</span>
          <span class="text-base">↗</span>
        </a>
      </div>
    </div>

    <!-- 3 Featured Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      
      <!-- Project 1: Valle del Sondondo Expeditions -->
      <div class="bg-white rounded-3xl border-3 border-zinc-900 shadow-brutal overflow-hidden flex flex-col group hover:-translate-y-1 hover:shadow-brutal-lg transition-all duration-200">
        <!-- Mock Browser Header -->
        <div class="px-4 py-3 bg-zinc-900 border-b-2 border-zinc-900 flex items-center justify-between">
          <div class="flex items-center gap-1.5">
            <span class="w-3 h-3 rounded-full bg-red-500 inline-block border border-zinc-900"></span>
            <span class="w-3 h-3 rounded-full bg-amber-400 inline-block border border-zinc-900"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-400 inline-block border border-zinc-900"></span>
          </div>
          <span class="text-[11px] font-mono text-zinc-400 font-semibold truncate">valledelsondondoexpeditions.com</span>
          <span class="text-zinc-500 text-xs">🔒</span>
        </div>

        <!-- Banner Visual -->
        <div class="relative h-44 sm:h-48 overflow-hidden bg-zinc-900">
          <img 
            src="/images/portfolio/sondondo.webp" 
            alt="Valle del Sondondo Expeditions" 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/80 via-transparent to-transparent flex items-end p-4">
            <span class="px-3 py-1 rounded-full bg-emerald-600/90 backdrop-blur-md text-[10px] font-extrabold uppercase tracking-wider text-white border border-emerald-400/40">
              Turismo &middot; Ayacucho, Perú
            </span>
          </div>
        </div>

        <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
          <div class="space-y-2">
            <h3 class="text-lg font-black font-display text-zinc-900 group-hover:text-indigo-600 transition-colors">
              Valle del Sondondo Expeditions
            </h3>
            <p class="text-xs sm:text-sm text-zinc-600 font-medium leading-relaxed">
              Plataforma turística de expediciones y ecoturismo: avistamiento del Cóndor Andino en Mayobamba, trekking y reservas con certificación Safe Travels.
            </p>
            
            <div class="p-2.5 rounded-xl bg-emerald-50 border border-emerald-300 flex items-center justify-between text-xs font-bold text-emerald-900">
              <span>🏔️ Safe Travels:</span>
              <span class="font-extrabold text-emerald-700">Operador Oficial</span>
            </div>
          </div>

          <div class="pt-3 border-t border-zinc-200 flex items-center justify-between">
            <div class="flex flex-wrap gap-1 text-[10px] font-extrabold text-zinc-700 uppercase">
              <span class="px-2 py-0.5 bg-zinc-100 rounded border border-zinc-300">Angular</span>
              <span class="px-2 py-0.5 bg-zinc-100 rounded border border-zinc-300">PWA</span>
              <span class="px-2 py-0.5 bg-zinc-100 rounded border border-zinc-300">SEO Local</span>
            </div>
            <a 
              href="https://valledelsondondoexpeditions.com/" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="text-xs font-extrabold text-indigo-600 hover:text-indigo-800 flex items-center gap-1"
            >
              Visitar ↗
            </a>
          </div>
        </div>
      </div>

      <!-- Project 2: Florería La Carreta -->
      <div class="bg-white rounded-3xl border-3 border-zinc-900 shadow-brutal overflow-hidden flex flex-col group hover:-translate-y-1 hover:shadow-brutal-lg transition-all duration-200">
        <!-- Mock Browser Header -->
        <div class="px-4 py-3 bg-zinc-900 border-b-2 border-zinc-900 flex items-center justify-between">
          <div class="flex items-center gap-1.5">
            <span class="w-3 h-3 rounded-full bg-red-500 inline-block border border-zinc-900"></span>
            <span class="w-3 h-3 rounded-full bg-amber-400 inline-block border border-zinc-900"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-400 inline-block border border-zinc-900"></span>
          </div>
          <span class="text-[11px] font-mono text-zinc-400 font-semibold truncate">floreria.molinazdev.lat</span>
          <span class="text-zinc-500 text-xs">🔒</span>
        </div>

        <!-- Banner Visual -->
        <div class="relative h-44 sm:h-48 overflow-hidden bg-zinc-900">
          <img 
            src="/images/portfolio/floreria.webp" 
            alt="Florería La Carreta" 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/80 via-transparent to-transparent flex items-end p-4">
            <span class="px-3 py-1 rounded-full bg-rose-600/90 backdrop-blur-md text-[10px] font-extrabold uppercase tracking-wider text-white border border-rose-400/40">
              E-Commerce &middot; Arreglos Florales
            </span>
          </div>
        </div>

        <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
          <div class="space-y-2">
            <h3 class="text-lg font-black font-display text-zinc-900 group-hover:text-indigo-600 transition-colors">
              Florería La Carreta
            </h3>
            <p class="text-xs sm:text-sm text-zinc-600 font-medium leading-relaxed">
              Tienda online de arreglos florales artesanales con entrega a domicilio, catálogo interactivo y checkout directo vía WhatsApp.
            </p>
            
            <div class="p-2.5 rounded-xl bg-emerald-50 border border-emerald-300 flex items-center justify-between text-xs font-bold text-emerald-900">
              <span>🌸 WhatsApp:</span>
              <span class="font-extrabold text-emerald-700">Conversión en 1 clic</span>
            </div>
          </div>

          <div class="pt-3 border-t border-zinc-200 flex items-center justify-between">
            <div class="flex flex-wrap gap-1 text-[10px] font-extrabold text-zinc-700 uppercase">
              <span class="px-2 py-0.5 bg-zinc-100 rounded border border-zinc-300">Astro</span>
              <span class="px-2 py-0.5 bg-zinc-100 rounded border border-zinc-300">TailwindCSS</span>
              <span class="px-2 py-0.5 bg-zinc-100 rounded border border-zinc-300">Mobile-First</span>
            </div>
            <a 
              href="https://floreria.molinazdev.lat/" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="text-xs font-extrabold text-indigo-600 hover:text-indigo-800 flex items-center gap-1"
            >
              Visitar ↗
            </a>
          </div>
        </div>
      </div>

      <!-- Project 3: Leart Store -->
      <div class="bg-white rounded-3xl border-3 border-zinc-900 shadow-brutal overflow-hidden flex flex-col group hover:-translate-y-1 hover:shadow-brutal-lg transition-all duration-200">
        <!-- Mock Browser Header -->
        <div class="px-4 py-3 bg-zinc-900 border-b-2 border-zinc-900 flex items-center justify-between">
          <div class="flex items-center gap-1.5">
            <span class="w-3 h-3 rounded-full bg-red-500 inline-block border border-zinc-900"></span>
            <span class="w-3 h-3 rounded-full bg-amber-400 inline-block border border-zinc-900"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-400 inline-block border border-zinc-900"></span>
          </div>
          <span class="text-[11px] font-mono text-zinc-400 font-semibold truncate">leart.molinazdev.lat</span>
          <span class="text-zinc-500 text-xs">🔒</span>
        </div>

        <!-- Banner Visual -->
        <div class="relative h-44 sm:h-48 overflow-hidden bg-zinc-900">
          <img 
            src="/images/portfolio/leart.webp" 
            alt="Leart Store" 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/80 via-transparent to-transparent flex items-end p-4">
            <span class="px-3 py-1 rounded-full bg-amber-500/90 backdrop-blur-md text-[10px] font-extrabold uppercase tracking-wider text-zinc-950 border border-amber-300/40">
              E-Commerce &middot; Regalos Personalizados
            </span>
          </div>
        </div>

        <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
          <div class="space-y-2">
            <h3 class="text-lg font-black font-display text-zinc-900 group-hover:text-indigo-600 transition-colors">
              Leart Store
            </h3>
            <p class="text-xs sm:text-sm text-zinc-600 font-medium leading-relaxed">
              Tienda online de cuadros y sets armables con minifiguras estilo brick personalizadas. Catálogo interactivo y envíos nacionales.
            </p>
            
            <div class="p-2.5 rounded-xl bg-emerald-50 border border-emerald-300 flex items-center justify-between text-xs font-bold text-emerald-900">
              <span>🎨 Catálogo 3D:</span>
              <span class="font-extrabold text-emerald-700">Minifiguras &amp; Sets</span>
            </div>
          </div>

          <div class="pt-3 border-t border-zinc-200 flex items-center justify-between">
            <div class="flex flex-wrap gap-1 text-[10px] font-extrabold text-zinc-700 uppercase">
              <span class="px-2 py-0.5 bg-zinc-100 rounded border border-zinc-300">Angular</span>
              <span class="px-2 py-0.5 bg-zinc-100 rounded border border-zinc-300">TypeScript</span>
              <span class="px-2 py-0.5 bg-zinc-100 rounded border border-zinc-300">TailwindCSS</span>
            </div>
            <a 
              href="https://leart.molinazdev.lat/" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="text-xs font-extrabold text-indigo-600 hover:text-indigo-800 flex items-center gap-1"
            >
              Visitar ↗
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Action Button -->
    <div class="mt-10 text-center">
      <a 
        href="/portafolio/" 
        class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full text-xs uppercase tracking-wider font-extrabold bg-white text-zinc-900 hover:bg-zinc-900 hover:text-white border-2 border-zinc-900 shadow-brutal hover:shadow-brutal-lg transition-all"
      >
        <span>Explorar todos los casos de estudio en el Portafolio</span>
        <span class="text-base">💼</span>
      </a>
    </div>

  </div>
</section>
