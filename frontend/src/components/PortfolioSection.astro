---
---

<section id="portafolio" class="py-16 md:py-24 bg-white border-b-2 border-zinc-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
      <div class="space-y-3 max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-zinc-100 border-2 border-zinc-900 text-xs font-black uppercase tracking-wider text-zinc-900 shadow-brutal-sm">
          <span>💼</span> Portafolio &amp; Casos de Estudio
        </div>
        <h2 class="text-3xl sm:text-5xl font-extrabold text-zinc-900 font-display tracking-tight">
          Proyectos reales que impulsan negocios.
        </h2>
        <p class="text-sm sm:text-base text-zinc-600 font-medium">
          Una selección de plataformas web, tiendas online y agentes de inteligencia artificial creados con arquitectura moderna y enfoque en conversión.
        </p>
      </div>

      <div class="shrink-0">
        <button 
          type="button" 
          data-open-booking-modal
          class="inline-flex items-center gap-2 px-5 py-3 rounded-full text-xs uppercase tracking-wider font-extrabold bg-emerald-600 hover:bg-emerald-500 text-white border-2 border-zinc-900 shadow-brutal hover:shadow-brutal-lg transition-all"
        >
          <span>Cotizar Proyecto Similar</span>
          <span class="text-base">↗</span>
        </button>
      </div>
    </div>

    <!-- Portfolio Grid (Ready for user URLs and images) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      
      <!-- Project 1: E-Commerce -->
      <div class="bg-zinc-50 rounded-3xl border-3 border-zinc-900 shadow-brutal overflow-hidden flex flex-col group hover:-translate-y-1 hover:shadow-brutal-lg transition-all duration-200">
        <!-- Browser Header Window -->
        <div class="px-4 py-3 bg-zinc-900 border-b-2 border-zinc-900 flex items-center justify-between">
          <div class="flex items-center gap-1.5">
            <span class="w-3 h-3 rounded-full bg-red-500 inline-block border border-zinc-900"></span>
            <span class="w-3 h-3 rounded-full bg-amber-400 inline-block border border-zinc-900"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-400 inline-block border border-zinc-900"></span>
          </div>
          <span class="text-[11px] font-mono text-zinc-400 font-semibold truncate max-w-[200px]">tienda-demo.molinazdev.lat</span>
          <span class="text-zinc-500 text-xs">🔒</span>
        </div>

        <!-- Project Visual Placeholder / Banner -->
        <!-- NOTA: Reemplazar el fondo o insertar imagen real en este contenedor -->
        <div class="h-48 sm:h-52 bg-gradient-to-br from-indigo-500 via-indigo-600 to-zinc-900 p-6 flex flex-col justify-end text-white relative overflow-hidden">
          <div class="absolute inset-0 opacity-15 bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:16px_16px]"></div>
          <span class="inline-block px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-[11px] font-extrabold uppercase tracking-wider text-white border border-white/30 w-fit mb-2">
            E-Commerce &middot; Retail &amp; Moda
          </span>
          <h3 class="text-xl font-black font-display leading-tight text-white drop-shadow">
            Plataforma E-Commerce de Alta Velocidad
          </h3>
        </div>

        <!-- Project Body -->
        <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
          <div class="space-y-2">
            <p class="text-xs sm:text-sm text-zinc-600 font-medium leading-relaxed">
              Catálogo de +500 productos, pasarela Mercado Pago integrada, sincronización de stock y checkout en 2 pasos para móviles.
            </p>
            
            <!-- Metrics Pill -->
            <div class="p-2.5 rounded-xl bg-emerald-50 border border-emerald-300 flex items-center justify-between text-xs font-bold text-emerald-900">
              <span>🚀 Rendimiento Móvil:</span>
              <span class="font-extrabold text-emerald-700">0.8s LCP (Score 98)</span>
            </div>
          </div>

          <!-- Stack Badges -->
          <div class="space-y-3 pt-2 border-t border-zinc-200">
            <div class="flex flex-wrap gap-1.5 text-[10px] font-extrabold uppercase text-zinc-700">
              <span class="px-2.5 py-0.5 rounded-md bg-zinc-200 border border-zinc-300">Astro</span>
              <span class="px-2.5 py-0.5 rounded-md bg-zinc-200 border border-zinc-300">.NET 8</span>
              <span class="px-2.5 py-0.5 rounded-md bg-zinc-200 border border-zinc-300">Mercado Pago</span>
              <span class="px-2.5 py-0.5 rounded-md bg-zinc-200 border border-zinc-300">MySQL</span>
            </div>

            <!-- Action Link (Reemplazar href con enlace real cuando lo desees) -->
            <a 
              href="#servicios" 
              class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl text-xs font-extrabold uppercase tracking-wider bg-white hover:bg-zinc-900 hover:text-white text-zinc-900 border-2 border-zinc-900 shadow-brutal-sm transition-all"
            >
              <span>Ver Paquetes de E-Commerce</span>
              <span>↗</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Project 2: AI WhatsApp Agent -->
      <div class="bg-zinc-50 rounded-3xl border-3 border-zinc-900 shadow-brutal overflow-hidden flex flex-col group hover:-translate-y-1 hover:shadow-brutal-lg transition-all duration-200">
        <!-- Browser Header Window -->
        <div class="px-4 py-3 bg-zinc-900 border-b-2 border-zinc-900 flex items-center justify-between">
          <div class="flex items-center gap-1.5">
            <span class="w-3 h-3 rounded-full bg-red-500 inline-block border border-zinc-900"></span>
            <span class="w-3 h-3 rounded-full bg-amber-400 inline-block border border-zinc-900"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-400 inline-block border border-zinc-900"></span>
          </div>
          <span class="text-[11px] font-mono text-zinc-400 font-semibold truncate max-w-[200px]">api-whatsapp.molinazdev.lat</span>
          <span class="text-zinc-500 text-xs">🤖</span>
        </div>

        <!-- Project Visual Placeholder / Banner -->
        <!-- NOTA: Reemplazar el fondo o insertar imagen real en este contenedor -->
        <div class="h-48 sm:h-52 bg-gradient-to-br from-emerald-600 via-teal-700 to-zinc-900 p-6 flex flex-col justify-end text-white relative overflow-hidden">
          <div class="absolute inset-0 opacity-15 bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:16px_16px]"></div>
          <span class="inline-block px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-[11px] font-extrabold uppercase tracking-wider text-white border border-white/30 w-fit mb-2">
            Inteligencia Artificial &middot; Salud &amp; Citas
          </span>
          <h3 class="text-xl font-black font-display leading-tight text-white drop-shadow">
            Agente IA de Triaje y Agendamiento 24/7
          </h3>
        </div>

        <!-- Project Body -->
        <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
          <div class="space-y-2">
            <p class="text-xs sm:text-sm text-zinc-600 font-medium leading-relaxed">
              Bot conversacional en WhatsApp con IA que atiende pacientes, responde sobre especialidades médicas y agenda citas en tiempo real.
            </p>
            
            <!-- Metrics Pill -->
            <div class="p-2.5 rounded-xl bg-emerald-50 border border-emerald-300 flex items-center justify-between text-xs font-bold text-emerald-900">
              <span>📈 Impacto en Atención:</span>
              <span class="font-extrabold text-emerald-700">+4,200 citas/mes</span>
            </div>
          </div>

          <!-- Stack Badges -->
          <div class="space-y-3 pt-2 border-t border-zinc-200">
            <div class="flex flex-wrap gap-1.5 text-[10px] font-extrabold uppercase text-zinc-700">
              <span class="px-2.5 py-0.5 rounded-md bg-zinc-200 border border-zinc-300">WhatsApp API</span>
              <span class="px-2.5 py-0.5 rounded-md bg-zinc-200 border border-zinc-300">OpenAI</span>
              <span class="px-2.5 py-0.5 rounded-md bg-zinc-200 border border-zinc-300">Node.js</span>
              <span class="px-2.5 py-0.5 rounded-md bg-zinc-200 border border-zinc-300">PostgreSQL</span>
            </div>

            <!-- Action Link -->
            <a 
              href="#demo-ia" 
              class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl text-xs font-extrabold uppercase tracking-wider bg-white hover:bg-zinc-900 hover:text-white text-zinc-900 border-2 border-zinc-900 shadow-brutal-sm transition-all"
            >
              <span>Probar Simulador de Chatbot</span>
              <span>⚡</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Project 3: Corporate Portal & Real Estate -->
      <div class="bg-zinc-50 rounded-3xl border-3 border-zinc-900 shadow-brutal overflow-hidden flex flex-col group hover:-translate-y-1 hover:shadow-brutal-lg transition-all duration-200">
        <!-- Browser Header Window -->
        <div class="px-4 py-3 bg-zinc-900 border-b-2 border-zinc-900 flex items-center justify-between">
          <div class="flex items-center gap-1.5">
            <span class="w-3 h-3 rounded-full bg-red-500 inline-block border border-zinc-900"></span>
            <span class="w-3 h-3 rounded-full bg-amber-400 inline-block border border-zinc-900"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-400 inline-block border border-zinc-900"></span>
          </div>
          <span class="text-[11px] font-mono text-zinc-400 font-semibold truncate max-w-[200px]">inmobiliaria-demo.pe</span>
          <span class="text-zinc-500 text-xs">🏢</span>
        </div>

        <!-- Project Visual Placeholder / Banner -->
        <!-- NOTA: Reemplazar el fondo o insertar imagen real en este contenedor -->
        <div class="h-48 sm:h-52 bg-gradient-to-br from-amber-500 via-orange-600 to-zinc-900 p-6 flex flex-col justify-end text-white relative overflow-hidden">
          <div class="absolute inset-0 opacity-15 bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:16px_16px]"></div>
          <span class="inline-block px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-[11px] font-extrabold uppercase tracking-wider text-white border border-white/30 w-fit mb-2">
            Portal Web &middot; Inmobiliario &amp; B2B
          </span>
          <h3 class="text-xl font-black font-display leading-tight text-white drop-shadow">
            Portal Inmobiliario &amp; Cotizador Interactivo
          </h3>
        </div>

        <!-- Project Body -->
        <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
          <div class="space-y-2">
            <p class="text-xs sm:text-sm text-zinc-600 font-medium leading-relaxed">
              Sitio corporativo con catálogo interactivo de propiedades, simulador de cuotas bancarias y derivación inteligente de leads a ejecutivos de venta.
            </p>
            
            <!-- Metrics Pill -->
            <div class="p-2.5 rounded-xl bg-emerald-50 border border-emerald-300 flex items-center justify-between text-xs font-bold text-emerald-900">
              <span>🎯 Generación de Leads:</span>
              <span class="font-extrabold text-emerald-700">+125% prospectos</span>
            </div>
          </div>

          <!-- Stack Badges -->
          <div class="space-y-3 pt-2 border-t border-zinc-200">
            <div class="flex flex-wrap gap-1.5 text-[10px] font-extrabold uppercase text-zinc-700">
              <span class="px-2.5 py-0.5 rounded-md bg-zinc-200 border border-zinc-300">Astro SSG</span>
              <span class="px-2.5 py-0.5 rounded-md bg-zinc-200 border border-zinc-300">TailwindCSS</span>
              <span class="px-2.5 py-0.5 rounded-md bg-zinc-200 border border-zinc-300">SEO Schema</span>
              <span class="px-2.5 py-0.5 rounded-md bg-zinc-200 border border-zinc-300">Lead CRM</span>
            </div>

            <!-- Action Link -->
            <button 
              type="button"
              data-open-booking-modal
              class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl text-xs font-extrabold uppercase tracking-wider bg-white hover:bg-zinc-900 hover:text-white text-zinc-900 border-2 border-zinc-900 shadow-brutal-sm transition-all"
            >
              <span>Consultar por este Formato</span>
              <span>💬</span>
            </button>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Notice for User Customization -->
    <div class="mt-12 p-6 rounded-2xl bg-zinc-50 border-2 border-zinc-900 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="text-2xl">💡</span>
        <p class="text-xs sm:text-sm text-zinc-700 font-medium">
          <strong>¿Tienes un proyecto especial con especificaciones a medida?</strong> Construimos arquitecturas escalables adaptadas a tus procesos actuales.
        </p>
      </div>
      <button 
        type="button" 
        data-open-booking-modal 
        class="shrink-0 px-5 py-2.5 rounded-full text-xs font-extrabold uppercase tracking-wider bg-zinc-900 text-white hover:bg-indigo-600 border-2 border-zinc-900 shadow-brutal-sm transition-all"
      >
        Agendar Asesoría Técnica Gratuita
      </button>
    </div>

  </div>
</section>
