---
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b-2 border-zinc-900 transition-shadow duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group focus:outline-none">
      <div class="w-9 h-9 rounded-xl bg-zinc-900 flex items-center justify-center text-white font-extrabold text-lg border-2 border-zinc-900 shadow-brutal-sm group-hover:-translate-y-0.5 transition-transform">
        M
      </div>
      <span class="font-extrabold tracking-tight text-xl text-zinc-900 font-display">
        Molinaz<span class="text-indigo-600">Dev</span>
      </span>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-bold text-zinc-700">
      <a href="/#por-que" class="hover:text-indigo-600 transition-colors py-1">Por qué nosotros</a>
      <a href="/#servicios" class="hover:text-indigo-600 transition-colors py-1">Servicios &amp; Precios</a>
      <a href="/#proceso" class="hover:text-indigo-600 transition-colors py-1">Cómo funciona</a>
      <a href="/#preguntas" class="hover:text-indigo-600 transition-colors py-1">Preguntas</a>
    </nav>

    <!-- Header Action Button -->
    <div class="hidden md:flex items-center gap-4">
      <a 
        href="/#servicios" 
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs uppercase tracking-wider font-extrabold bg-zinc-900 text-white hover:bg-indigo-600 transition-all duration-200 border-2 border-zinc-900 shadow-brutal-sm hover:shadow-brutal hover:-translate-y-0.5"
      >
        <span>Ver Paquetes</span>
        <span class="text-indigo-300 font-bold">↗</span>
      </a>
    </div>

    <!-- Mobile Hamburger Button -->
    <button 
      id="mobile-menu-btn"
      type="button" 
      aria-label="Abrir menú" 
      aria-controls="mobile-menu"
      aria-expanded="false"
      class="md:hidden p-2 rounded-xl text-zinc-900 hover:bg-zinc-100 border-2 border-zinc-900 focus:outline-none"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16m-7 6h7" />
      </svg>
    </button>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-menu" class="hidden md:hidden border-b-2 border-zinc-900 bg-white px-6 py-6 space-y-4 shadow-xl">
    <a href="/#por-que" class="block text-base font-bold text-zinc-800 hover:text-indigo-600 mobile-nav-link">Por qué nosotros</a>
    <a href="/#servicios" class="block text-base font-bold text-zinc-800 hover:text-indigo-600 mobile-nav-link">Servicios y Precios</a>
    <a href="/#proceso" class="block text-base font-bold text-zinc-800 hover:text-indigo-600 mobile-nav-link">Cómo funciona</a>
    <a href="/#preguntas" class="block text-base font-bold text-zinc-800 hover:text-indigo-600 mobile-nav-link">Preguntas Frecuentes</a>
    <div class="pt-4 border-t-2 border-zinc-100">
      <a 
        href="/#servicios" 
        class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full text-sm font-extrabold bg-zinc-900 text-white hover:bg-indigo-600 transition-colors border-2 border-zinc-900 shadow-brutal-sm"
      >
        <span>Explorar Catálogo de Paquetes</span>
        <span class="text-indigo-300">↗</span>
      </a>
    </div>
  </div>
</header>

<script is:inline src="/js/navbar.js"></script>
