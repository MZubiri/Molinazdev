---
---

<header class="sticky top-0 z-40 bg-paper/95 backdrop-blur-md border-b-2 border-ink transition-shadow duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group focus:outline-none">
      <div class="w-9 h-9 rounded-lg bg-ink flex items-center justify-center text-acid font-extrabold text-lg border-2 border-ink shadow-brutal-sm group-hover:-translate-y-0.5 transition-transform">
        M
      </div>
      <span class="font-extrabold tracking-tight text-xl text-ink font-display">
        Molinaz<span class="text-brand">Dev</span>
      </span>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-bold text-ink">
      <a href="/#por-que" class="hover:text-brand transition-colors relative py-1 hover:underline decoration-acid decoration-4 underline-offset-4">Por qué una solución</a>
      <a href="/#servicios" class="hover:text-brand transition-colors relative py-1 hover:underline decoration-acid decoration-4 underline-offset-4">Servicios & Precios</a>
      <a href="/#proceso" class="hover:text-brand transition-colors relative py-1 hover:underline decoration-acid decoration-4 underline-offset-4">Cómo funciona</a>
      <a href="/#preguntas" class="hover:text-brand transition-colors relative py-1 hover:underline decoration-acid decoration-4 underline-offset-4">Preguntas</a>
    </nav>

    <!-- Header Action Button -->
    <div class="hidden md:flex items-center gap-4">
      <a 
        href="/#servicios" 
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs uppercase tracking-wider font-extrabold bg-ink text-white hover:bg-brand transition-all duration-200 border-2 border-ink shadow-brutal-sm hover:shadow-brutal hover:-translate-y-0.5"
      >
        <span>Ver Paquetes</span>
        <span class="text-acid font-bold">↗</span>
      </a>
    </div>

    <!-- Mobile Hamburger Button -->
    <button 
      id="mobile-menu-btn"
      type="button" 
      aria-label="Abrir menú" 
      class="md:hidden p-2 rounded-lg text-ink hover:bg-paper-subtle border-2 border-ink focus:outline-none"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16m-7 6h7" />
      </svg>
    </button>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-menu" class="hidden md:hidden border-b-2 border-ink bg-paper px-6 py-6 space-y-4 shadow-lg">
    <a href="/#por-que" class="block text-base font-bold text-ink hover:text-brand mobile-nav-link">Por qué una solución</a>
    <a href="/#servicios" class="block text-base font-bold text-ink hover:text-brand mobile-nav-link">Servicios y Precios</a>
    <a href="/#proceso" class="block text-base font-bold text-ink hover:text-brand mobile-nav-link">Cómo funciona</a>
    <a href="/#preguntas" class="block text-base font-bold text-ink hover:text-brand mobile-nav-link">Preguntas Frecuentes</a>
    <div class="pt-4 border-t-2 border-ink/10">
      <a 
        href="/#servicios" 
        class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full text-sm font-extrabold bg-ink text-white hover:bg-brand transition-colors border-2 border-ink shadow-brutal-sm"
      >
        <span>Explorar Catálogo de Paquetes</span>
        <span class="text-acid">↗</span>
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const links = document.querySelectorAll('.mobile-nav-link');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  links.forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
    });
  });
</script>
