---
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b-2 border-zinc-900 transition-shadow duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group focus:outline-none">
      <div class="w-9 h-9 rounded-xl bg-zinc-900 flex items-center justify-center text-white font-extrabold text-lg border-2 border-zinc-900 shadow-brutal-sm group-hover:-translate-y-0.5 transition-transform">
        M
      </div>
      <span class="font-extrabold tracking-tight text-xl text-zinc-900 font-display">
        Molinaz<span class="text-indigo-600">Dev</span>
      </span>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="hidden lg:flex items-center gap-6 text-sm font-bold text-zinc-700">
      <a href="/servicios/" class="hover:text-indigo-600 transition-colors py-1">Servicios &amp; Precios</a>
      <a href="/portafolio/" class="hover:text-indigo-600 transition-colors py-1">Portafolio</a>
      <a href="/demo-ia/" class="hover:text-indigo-600 transition-colors py-1 flex items-center gap-1.5">
        <span>Demo IA</span>
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      </a>
      <a href="/#auditoria" class="hover:text-indigo-600 transition-colors py-1 text-amber-700 font-extrabold">Auditoría Gratis</a>
      <a href="/contacto/" class="hover:text-indigo-600 transition-colors py-1">Contacto</a>
    </nav>

    <!-- Header Action Button -->
    <div class="hidden md:flex items-center gap-3">
      <button 
        type="button" 
        data-open-booking-modal
        class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-full text-xs uppercase tracking-wider font-extrabold bg-emerald-600 text-white hover:bg-emerald-500 transition-all duration-200 border-2 border-zinc-900 shadow-brutal-sm hover:shadow-brutal hover:-translate-y-0.5"
      >
        <span>Agendar Asesoría</span>
        <span class="text-sm">📅</span>
      </button>

      <a 
        href="/servicios/" 
        class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-full text-xs uppercase tracking-wider font-extrabold bg-zinc-900 text-white hover:bg-indigo-600 transition-all duration-200 border-2 border-zinc-900 shadow-brutal-sm hover:shadow-brutal hover:-translate-y-0.5"
      >
        <span>Ver Paquetes</span>
        <span class="text-indigo-300 font-bold">↗</span>
      </a>
    </div>

    <!-- Mobile Hamburger Button -->
    <button 
      id="mobile-menu-btn"
      type="button" 
      aria-label="Abrir menú" 
      aria-controls="mobile-menu"
      aria-expanded="false"
      class="lg:hidden p-2.5 rounded-xl text-zinc-900 hover:bg-zinc-100 border-2 border-zinc-900 focus:outline-none min-h-[44px] min-w-[44px] flex items-center justify-center shadow-brutal-sm active:translate-y-0.5"
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16m-7 6h7" />
      </svg>
    </button>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-menu" class="hidden lg:hidden border-b-2 border-zinc-900 bg-white px-5 py-6 space-y-3.5 shadow-xl">
    <a href="/" class="block text-base font-extrabold text-zinc-900 hover:text-indigo-600 mobile-nav-link py-1.5">Inicio</a>
    <a href="/servicios/" class="block text-base font-extrabold text-zinc-900 hover:text-indigo-600 mobile-nav-link py-1.5">Servicios &amp; Precios</a>
    <a href="/portafolio/" class="block text-base font-extrabold text-zinc-900 hover:text-indigo-600 mobile-nav-link py-1.5">Portafolio de Proyectos</a>
    <a href="/demo-ia/" class="block text-base font-extrabold text-zinc-900 hover:text-indigo-600 mobile-nav-link py-1.5 flex items-center justify-between">
      <span>Simulador Chatbot IA</span>
      <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-black uppercase">En Vivo</span>
    </a>
    <a href="/#auditoria" class="block text-base font-extrabold text-amber-700 hover:text-amber-800 mobile-nav-link py-1.5">🎁 Auditoría Web Gratuita</a>
    <a href="/contacto/" class="block text-base font-extrabold text-zinc-900 hover:text-indigo-600 mobile-nav-link py-1.5">Contacto Directo</a>

    <div class="pt-4 border-t-2 border-zinc-200 space-y-3">
      <button 
        type="button" 
        data-open-booking-modal
        class="w-full inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-full text-xs uppercase tracking-wider font-extrabold bg-emerald-600 text-white hover:bg-emerald-500 transition-colors border-2 border-zinc-900 shadow-brutal-sm"
      >
        <span>Agendar Asesoría Técnica Gratuita</span>
        <span>📅</span>
      </button>

      <a 
        href="/servicios/" 
        class="w-full inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-full text-xs uppercase tracking-wider font-extrabold bg-zinc-900 text-white hover:bg-indigo-600 transition-colors border-2 border-zinc-900 shadow-brutal-sm"
      >
        <span>Explorar Catálogo de Paquetes</span>
        <span class="text-indigo-300 font-bold">↗</span>
      </a>
    </div>
  </div>
</header>

<script is:inline src="/js/navbar.js"></script>
