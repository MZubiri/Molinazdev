---
---

<!-- Checkout Modal Overlay -->
<div 
  id="checkout-modal" 
  class="fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-6 bg-ink/75 backdrop-blur-sm transition-opacity duration-200"
  aria-modal="true"
  role="dialog"
  aria-labelledby="modal-package-name"
  aria-describedby="checkout-privacy-note"
  aria-hidden="true"
>
  <div 
    id="checkout-card"
    class="relative w-full max-w-lg rounded-2xl bg-white border-2 border-ink p-6 sm:p-8 shadow-brutal-xl max-h-[92vh] overflow-y-auto"
  >
    <!-- Close Button -->
    <button 
      id="close-checkout-btn"
      type="button" 
      class="absolute top-6 right-6 w-9 h-9 rounded-full border-2 border-zinc-900 bg-zinc-100 hover:bg-zinc-200 flex items-center justify-center text-zinc-900 font-bold text-lg transition-colors focus:outline-none shadow-brutal-sm"
      aria-label="Cerrar modal"
    >
      &times;
    </button>

    <!-- Header -->
    <div class="space-y-1.5 pr-10">
      <span id="modal-service-title" class="text-xs uppercase tracking-widest text-indigo-600 font-extrabold block">Servicio Digital</span>
      <h3 id="modal-package-name" class="text-2xl sm:text-3xl font-extrabold text-zinc-900 font-display">Contratar Paquete</h3>
      <div class="flex items-center gap-2 pt-1">
        <span class="text-xs text-zinc-600 font-semibold">Precio base:</span>
        <span id="modal-package-price" class="text-2xl font-extrabold text-zinc-900 font-display">PEN 0.00 + IGV</span>
      </div>
    </div>

    <!-- Error Alert Box -->
    <div id="checkout-error-box" class="hidden mt-4 p-4 rounded-xl bg-red-50 border-2 border-red-800 text-xs font-bold text-red-900" role="alert" aria-live="assertive">
      <span id="checkout-error-msg"></span>
    </div>

    <!-- Checkout Form -->
    <form id="checkout-form" class="mt-6 space-y-4" novalidate>
      <input type="hidden" id="form-package-id" name="packageId" value="" />

      <div>
        <label for="form-name" class="block text-xs font-extrabold uppercase tracking-wider text-zinc-800 mb-1.5">
          Nombre completo <span class="text-red-600">*</span>
        </label>
        <input 
          type="text" 
          id="form-name" 
          name="fullName" 
          required 
          autocomplete="name"
          placeholder="Ej. Carlos Mendoza" 
          class="w-full px-4 py-3 rounded-xl bg-zinc-50 border-2 border-zinc-900 text-zinc-900 placeholder-zinc-400 text-sm font-medium focus:outline-none focus:bg-white focus:ring-2 focus:ring-zinc-900 transition-colors"
        />
      </div>

      <div>
        <label for="form-email" class="block text-xs font-extrabold uppercase tracking-wider text-zinc-800 mb-1.5">
          Correo electrónico <span class="text-red-600">*</span>
        </label>
        <input 
          type="email" 
          id="form-email" 
          name="email" 
          required 
          autocomplete="email"
          placeholder="nombre@empresa.com" 
          class="w-full px-4 py-3 rounded-xl bg-zinc-50 border-2 border-zinc-900 text-zinc-900 placeholder-zinc-400 text-sm font-medium focus:outline-none focus:bg-white focus:ring-2 focus:ring-zinc-900 transition-colors"
        />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="form-phone" class="block text-xs font-extrabold uppercase tracking-wider text-zinc-800 mb-1.5">
            Teléfono / WhatsApp
          </label>
          <input 
            type="tel" 
            id="form-phone" 
            name="phoneNumber" 
            autocomplete="tel"
            placeholder="+51 987 654 321" 
            class="w-full px-4 py-3 rounded-xl bg-zinc-50 border-2 border-zinc-900 text-zinc-900 placeholder-zinc-400 text-sm font-medium focus:outline-none focus:bg-white focus:ring-2 focus:ring-zinc-900 transition-colors"
          />
        </div>

        <div>
          <label for="form-company" class="block text-xs font-extrabold uppercase tracking-wider text-zinc-800 mb-1.5">
            Empresa (Opcional)
          </label>
          <input 
            type="text" 
            id="form-company" 
            name="companyName" 
            autocomplete="organization"
            placeholder="Mi Empresa S.A.C." 
            class="w-full px-4 py-3 rounded-xl bg-zinc-50 border-2 border-zinc-900 text-zinc-900 placeholder-zinc-400 text-sm font-medium focus:outline-none focus:bg-white focus:ring-2 focus:ring-zinc-900 transition-colors"
          />
        </div>
      </div>

      <!-- Submit Button -->
      <div class="pt-4">
        <button 
          id="submit-checkout-btn"
          type="submit" 
          class="w-full py-4 px-6 rounded-full text-xs sm:text-sm uppercase tracking-wider font-extrabold text-white bg-zinc-900 hover:bg-indigo-600 border-2 border-zinc-900 shadow-brutal hover:shadow-brutal-lg transition-all duration-150 flex items-center justify-center gap-2"
        >
          <span id="btn-text">Continuar a Mercado Pago</span>
          <span id="btn-spinner" class="hidden animate-spin h-4 w-4 border-2 border-white border-t-transparent rounded-full"></span>
          <span id="btn-arrow" class="text-indigo-300 font-bold text-base">↗</span>
        </button>
      </div>

      <div id="checkout-privacy-note" class="p-3 bg-zinc-50 border border-zinc-200 rounded-xl text-[11px] text-zinc-600 text-center font-medium">
        🔒 Tus datos están protegidos. El precio base y el IGV se validan en el servidor; verás el importe total antes de completar la operación en Mercado Pago.
      </div>
    </form>
  </div>
</div>

<script is:inline src="/js/checkout.js"></script>
