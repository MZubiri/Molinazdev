<section id="proceso" class="py-16 md:py-24 border-b-2 border-zinc-900 bg-zinc-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Index -->
    <div class="text-xs font-extrabold tracking-widest text-zinc-500 uppercase mb-3 text-center md:text-left">
      03 / CÓMO TRABAJAMOS
    </div>

    <!-- Header -->
    <div class="max-w-3xl space-y-2 mb-12 text-center md:text-left">
      <h2 class="text-3xl sm:text-5xl font-extrabold text-zinc-900 font-display leading-[1.12]">
        Metodología clara, rápida y sin contratiempos
      </h2>
      <p class="text-sm sm:text-base text-zinc-600 font-medium">
        Un proceso estructurado para que conozcas los avances y entregables en todo momento.
      </p>
    </div>

    <!-- 4 Steps Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      
      <div class="card-brutal p-6 space-y-3 bg-white">
        <span class="inline-block px-2.5 py-1 rounded-md bg-zinc-900 text-white font-extrabold text-xs font-display">
          PASO 01
        </span>
        <h3 class="text-lg font-extrabold text-zinc-900 font-display">Selecciona tu Plan</h3>
        <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium">
          Elige entre Landing Page (S/. 799), Web Autoadministrable, Ecommerce o Software con precio y plazo pactado.
        </p>
      </div>

      <div class="card-brutal p-6 space-y-3 bg-white">
        <span class="inline-block px-2.5 py-1 rounded-md bg-zinc-900 text-white font-extrabold text-xs font-display">
          PASO 02
        </span>
        <h3 class="text-lg font-extrabold text-zinc-900 font-display">Orden &amp; Alcance</h3>
        <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium">
          Ingresas tus datos de contacto para generar la orden única y formalizar el alcance y fecha de entrega.
        </p>
      </div>

      <div class="card-brutal p-6 space-y-3 bg-white">
        <span class="inline-block px-2.5 py-1 rounded-md bg-indigo-600 text-white font-extrabold text-xs font-display shadow-sm">
          PASO 03
        </span>
        <h3 class="text-lg font-extrabold text-zinc-900 font-display">Pago Flexible</h3>
        <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium">
          Pagas con total seguridad: Efectivo, Transferencia, Yape, Plin o Tarjeta de Crédito a meses sin intereses.
        </p>
      </div>

      <div class="card-brutal p-6 space-y-3 bg-white">
        <span class="inline-block px-2.5 py-1 rounded-md bg-zinc-900 text-white font-extrabold text-xs font-display">
          PASO 04
        </span>
        <h3 class="text-lg font-extrabold text-zinc-900 font-display">Lanzamiento &amp; Soporte</h3>
        <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed font-medium">
          Publicamos tu plataforma con hosting y dominio activo, y te acompañamos con soporte técnico por 60 días.
        </p>
      </div>

    </div>

  </div>
</section>
