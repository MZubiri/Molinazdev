---
const year = new Date().getFullYear();
---

<footer class="bg-paper border-t-2 border-ink py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 pb-12 border-b-2 border-ink/10">
      
      <!-- Brand (6 cols) -->
      <div class="md:col-span-6 space-y-4">
        <a href="/" class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-ink flex items-center justify-center text-acid font-extrabold text-base border-2 border-ink shadow-brutal-sm">
            M
          </div>
          <span class="font-extrabold tracking-tight text-xl text-ink font-display">
            Molinaz<span class="text-brand">Dev</span>
          </span>
        </a>
        <p class="text-sm text-ink/80 max-w-md font-medium leading-relaxed">
          Diseño web, desarrollo de software y chatbots con inteligencia artificial en Lima, Perú y para todo el mundo.
        </p>
      </div>

      <!-- Links (3 cols) -->
      <div class="md:col-span-3">
        <span class="text-xs font-extrabold uppercase tracking-widest text-ink block mb-4">Servicios</span>
        <ul class="space-y-2.5 text-sm font-semibold text-ink/80">
          <li><a href="/servicios/desarrollo-web" class="hover:text-brand hover:underline">Desarrollo Web</a></li>
          <li><a href="/servicios/chatbots-con-ia" class="hover:text-brand hover:underline">Chatbots con IA</a></li>
          <li><a href="/servicios/automatizaciones" class="hover:text-brand hover:underline">Automatizaciones</a></li>
          <li><a href="/servicios/software-a-medida" class="hover:text-brand hover:underline">Software a Medida</a></li>
        </ul>
      </div>

      <!-- Trust (3 cols) -->
      <div class="md:col-span-3">
        <span class="text-xs font-extrabold uppercase tracking-widest text-ink block mb-4">Garantía y Pagos</span>
        <div class="card-brutal p-4 space-y-1.5 bg-paper-subtle">
          <div class="font-extrabold text-xs text-ink flex items-center gap-1.5">
            <span>🛡️</span> Mercado Pago Checkout Pro
          </div>
          <p class="text-[11px] text-ink/70 leading-tight font-medium">
            Tarjetas, Yape, Plin y transferencias con protección al comprador.
          </p>
        </div>
      </div>

    </div>

    <!-- Bottom -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-bold text-ink/70">
      <p>&copy; {year} MolinazDev. Todos los derechos reservados.</p>
      <div class="flex items-center gap-4">
        <span>Lima, Perú</span>
        <span>&bull;</span>
        <span>Tecnología ASP.NET Core 8 & Astro</span>
      </div>
    </div>
  </div>
</footer>
