---
interface Props {
  phone?: string;
  message?: string;
}

const {
  phone = "51987654321",
  message = "Hola MolinazDev, quisiera información sobre sus servicios digitales."
} = Astro.props;

const whatsappUrl = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
---

<!-- Floating WhatsApp Button -->
<aside aria-label="Contacto por WhatsApp" class="fixed bottom-6 right-6 z-40 flex items-center group">
  <span class="hidden sm:inline-block mr-3 px-3.5 py-1.5 rounded-xl bg-zinc-900 text-white text-xs font-bold border-2 border-zinc-900 shadow-brutal-sm opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none">
    ¿Conversamos por WhatsApp?
  </span>

  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="w-14 h-14 rounded-full bg-emerald-500 hover:bg-emerald-400 text-zinc-900 border-2 border-zinc-900 flex items-center justify-center shadow-brutal hover:shadow-brutal-lg hover:-translate-y-1 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-zinc-900 relative"
    aria-label="Contactar por WhatsApp directamente con MolinazDev"
  >
    <!-- Pulse badge indicator -->
    <span class="absolute -top-1 -right-1 w-4 h-4 bg-emerald-300 rounded-full border-2 border-zinc-900 animate-ping"></span>
    <span class="absolute -top-1 -right-1 w-4 h-4 bg-emerald-400 rounded-full border-2 border-zinc-900"></span>

    <!-- WhatsApp SVG Icon -->
    <svg class="w-7 h-7 fill-white drop-shadow-sm" viewBox="0 0 24 24">
      <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.275.072.376-.043c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.423-14.416c-6.627 0-12 5.373-12 12 0 2.155.57 4.179 1.564 5.925l-1.564 5.719 5.864-1.538c1.684.921 3.616 1.45 5.674 1.45 6.627 0 12-5.373 12-12 0-6.627-5.373-12-12-12z"/>
    </svg>
  </a>
</aside>
