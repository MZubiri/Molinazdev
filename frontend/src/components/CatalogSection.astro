---
import { getCatalog, type ServiceCatalog } from '../lib/api';

const services: ServiceCatalog[] = await getCatalog();
---

<section id="servicios" class="py-20 md:py-28 border-b-2 border-ink bg-paper">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Index -->
    <div class="text-xs font-extrabold tracking-widest text-ink/60 uppercase mb-4 text-center md:text-left">
      02 / SERVICIOS & PRECIOS CLAROS
    </div>

    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div class="max-w-2xl space-y-3">
        <h2 class="text-3xl sm:text-5xl font-extrabold text-ink font-display leading-[1.1]">
          Elige el plan ideal para tu empresa
        </h2>
        <p class="text-base text-ink/80">
          Alcance, entregables y precio final confirmados. Sin costos ocultos y con pasarela de pago segura.
        </p>
      </div>

      <!-- Service Selector Tabs -->
      <div class="flex flex-wrap gap-2">
        {services.map((service, index) => (
          <button
            type="button"
            data-service-tab={service.slug}
            class={`category-tab px-4 py-2 rounded-full text-xs font-bold transition-all duration-150 border-2 border-ink ${
              index === 0
                ? 'bg-ink text-white shadow-brutal-sm -translate-y-0.5'
                : 'bg-white text-ink hover:bg-paper-subtle hover:shadow-brutal-sm'
            }`}
          >
            {service.title}
          </button>
        ))}
      </div>
    </div>

    <!-- Services Container -->
    <div class="space-y-16">
      {services.map((service, sIndex) => (
        <div 
          id={`service-panel-${service.slug}`}
          class={`service-panel ${sIndex === 0 ? 'block' : 'hidden'}`}
        >
          <!-- Service Intro Bar -->
          <div class="mb-8 p-6 rounded-2xl bg-paper-subtle border-2 border-ink flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
              <span class="text-xs font-extrabold uppercase tracking-wider text-brand">Categoría</span>
              <h3 class="text-2xl font-extrabold text-ink font-display">{service.title}</h3>
              {service.description && (
                <p class="text-xs sm:text-sm text-ink/80 mt-1 max-w-2xl">{service.description}</p>
              )}
            </div>
          </div>

          <!-- Packages Grid -->
          <div class={`grid gap-8 ${service.packages.length === 3 ? 'grid-cols-1 md:grid-cols-3' : 'grid-cols-1 md:grid-cols-2 max-w-4xl mx-auto'}`}>
            {service.packages.map((pkg, pIndex) => {
              const isPopular = pIndex === 1 || service.packages.length === 1;
              return (
                <div 
                  class={`card-brutal p-8 flex flex-col justify-between relative ${
                    isPopular ? 'bg-white ring-2 ring-ink ring-offset-2' : 'bg-white'
                  }`}
                >
                  {isPopular && (
                    <div class="absolute -top-3.5 right-6 px-3 py-0.5 rounded-full bg-acid border-2 border-ink text-ink text-[11px] font-extrabold uppercase tracking-wider shadow-brutal-sm">
                      ★ Más Solicitado
                    </div>
                  )}

                  <div>
                    <h4 class="text-2xl font-extrabold text-ink font-display">{pkg.name}</h4>
                    {pkg.description && (
                      <p class="text-xs text-ink/70 mt-2 min-h-[32px] font-medium leading-relaxed">{pkg.description}</p>
                    )}

                    <!-- Price & Days -->
                    <div class="mt-6 pt-6 border-t-2 border-ink/10">
                      <div class="flex items-baseline gap-1.5">
                        <span class="text-xs font-bold text-ink/60">{pkg.currency}</span>
                        <span class="text-3xl sm:text-4xl font-extrabold text-ink font-display tracking-tight">
                          {pkg.price.toLocaleString('es-PE', { minimumFractionDigits: 2 })}
                        </span>
                      </div>
                      <div class="inline-flex items-center gap-1.5 mt-2 text-xs font-bold text-ink bg-paper-subtle px-3 py-1 rounded-full border border-ink/30">
                        <span>⏱️ Plazo: ~{pkg.deliveryDays} días hábiles</span>
                      </div>
                    </div>

                    <!-- Checklist -->
                    <div class="mt-8 space-y-3">
                      <span class="text-xs font-extrabold uppercase tracking-wider text-ink/70 block">Incluye en el paquete:</span>
                      <ul class="space-y-2.5">
                        {pkg.features.map(feature => (
                          <li class="flex items-start gap-2.5 text-xs sm:text-sm text-ink/90 font-medium">
                            <span class="text-emerald-600 font-extrabold text-base leading-none">✓</span>
                            <span>{feature}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>

                  <!-- CTA Button -->
                  <div class="mt-8 pt-6 border-t-2 border-ink/10">
                    <button
                      type="button"
                      data-open-checkout
                      data-package-id={pkg.id}
                      data-package-name={pkg.name}
                      data-package-price={`${pkg.currency} ${pkg.price.toLocaleString('es-PE', { minimumFractionDigits: 2 })}`}
                      data-service-title={service.title}
                      class={`w-full py-4 px-6 text-xs sm:text-sm uppercase tracking-wider font-extrabold flex items-center justify-center gap-2 ${
                        isPopular ? 'btn-brutal-acid' : 'btn-brutal-primary'
                      }`}
                    >
                      <span>Contratar Paquete</span>
                      <span class="font-bold">↗</span>
                    </button>
                    <p class="text-[11px] text-ink/60 text-center mt-2.5 font-medium">
                      🔒 Pago verificado por Mercado Pago
                    </p>
                  </div>

                </div>
              );
            })}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.category-tab');
  const panels = document.querySelectorAll<HTMLElement>('.service-panel');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const slug = tab.getAttribute('data-service-tab');
      if (!slug) return;

      tabs.forEach(t => {
        t.classList.remove('bg-ink', 'text-white', 'shadow-brutal-sm', '-translate-y-0.5');
        t.classList.add('bg-white', 'text-ink');
      });
      tab.classList.remove('bg-white', 'text-ink');
      tab.classList.add('bg-ink', 'text-white', 'shadow-brutal-sm', '-translate-y-0.5');

      panels.forEach(p => {
        if (p.id === `service-panel-${slug}`) {
          p.classList.remove('hidden');
          p.classList.add('block');
        } else {
          p.classList.add('hidden');
          p.classList.remove('block');
        }
      });
    });
  });
</script>
