---
import { getCatalog, type ServiceCatalog } from '../lib/api';

const services: ServiceCatalog[] = await getCatalog();
---

<section id="servicios" class="py-24 relative bg-dark-surface/40 border-y border-zinc-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Heading -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-indigo-950/60 border border-indigo-500/30 text-xs font-semibold text-indigo-400 uppercase tracking-widest">
        Catálogo de Servicios
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white font-display">
        Planes diseñados para cada etapa de tu negocio
      </h2>
      <p class="text-base sm:text-lg text-zinc-400">
        Precios fijados por contrato y validados de forma segura en servidor. Selecciona un servicio para explorar los paquetes.
      </p>

      <!-- Category Filter Tabs -->
      <div class="flex flex-wrap items-center justify-center gap-2 pt-6">
        {services.map((service, index) => (
          <button
            type="button"
            data-service-tab={service.slug}
            class={`category-tab px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold transition-all duration-200 border ${
              index === 0
                ? 'bg-indigo-600 border-indigo-500 text-white shadow-glow-sm'
                : 'bg-dark-card/60 border-zinc-800 text-zinc-400 hover:text-white hover:border-zinc-700'
            }`}
          >
            {service.title}
          </button>
        ))}
      </div>
    </div>

    <!-- Services & Packages Grid -->
    <div class="space-y-16">
      {services.map((service, sIndex) => (
        <div 
          id={`service-panel-${service.slug}`}
          class={`service-panel transition-opacity duration-300 ${sIndex === 0 ? 'block' : 'hidden'}`}
        >
          <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4 border-b border-zinc-800/80 pb-4">
            <div>
              <span class="text-xs uppercase tracking-widest text-indigo-400 font-semibold">Servicio Especializado</span>
              <h3 class="text-2xl sm:text-3xl font-bold text-white font-display mt-1">{service.title}</h3>
              {service.description && (
                <p class="text-zinc-400 text-sm sm:text-base mt-1 max-w-2xl">{service.description}</p>
              )}
            </div>
          </div>

          <!-- Package Cards Grid -->
          <div class={`grid gap-6 ${service.packages.length === 3 ? 'grid-cols-1 md:grid-cols-3' : 'grid-cols-1 md:grid-cols-2 max-w-4xl mx-auto'}`}>
            {service.packages.map((pkg, pIndex) => {
              const isPopular = pIndex === 1 || service.packages.length === 1;
              return (
                <div 
                  class={`relative rounded-3xl p-8 flex flex-col justify-between transition-all duration-300 glass-card ${
                    isPopular 
                      ? 'border-indigo-500/50 bg-gradient-to-b from-dark-card to-indigo-950/20 shadow-glow-sm hover:shadow-glow-md' 
                      : 'border-zinc-800/90 hover:border-zinc-700 hover:bg-dark-card/90'
                  } hover:-translate-y-1`}
                >
                  {isPopular && (
                    <div class="absolute -top-3.5 right-6 px-3.5 py-1 rounded-full bg-gradient-to-r from-indigo-500 to-blue-500 text-white text-[11px] font-extrabold uppercase tracking-wider shadow-sm">
                      Recomendado
                    </div>
                  )}

                  <div>
                    <!-- Package Name & Desc -->
                    <h4 class="text-xl font-bold text-white font-display">{pkg.name}</h4>
                    {pkg.description && (
                      <p class="text-xs text-zinc-400 mt-2 min-h-[36px]">{pkg.description}</p>
                    )}

                    <!-- Price & Delivery -->
                    <div class="mt-6 pt-6 border-t border-zinc-800/80">
                      <div class="flex items-baseline gap-1.5">
                        <span class="text-xs font-semibold text-zinc-400">{pkg.currency}</span>
                        <span class="text-3xl sm:text-4xl font-extrabold text-white font-display tracking-tight">
                          {pkg.price.toLocaleString('es-PE', { minimumFractionDigits: 2 })}
                        </span>
                      </div>
                      <div class="inline-flex items-center gap-1.5 mt-2 text-xs font-medium text-indigo-400 bg-indigo-950/50 px-2.5 py-1 rounded-md border border-indigo-800/40">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span>Entrega en ~{pkg.deliveryDays} días hábiles</span>
                      </div>
                    </div>

                    <!-- Features Checklist -->
                    <div class="mt-8 space-y-3">
                      <span class="text-[11px] font-bold uppercase tracking-wider text-zinc-400">Qué incluye:</span>
                      <ul class="space-y-2.5">
                        {pkg.features.map(feature => (
                          <li class="flex items-start gap-2.5 text-xs sm:text-sm text-zinc-300">
                            <span class="text-emerald-400 mt-0.5 flex-shrink-0 font-bold">✓</span>
                            <span>{feature}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>

                  <!-- Checkout Action CTA -->
                  <div class="mt-8 pt-6 border-t border-zinc-800/80">
                    <button
                      type="button"
                      data-open-checkout
                      data-package-id={pkg.id}
                      data-package-name={pkg.name}
                      data-package-price={`${pkg.currency} ${pkg.price.toLocaleString('es-PE', { minimumFractionDigits: 2 })}`}
                      data-service-title={service.title}
                      class={`w-full py-3.5 px-6 rounded-2xl text-xs sm:text-sm font-bold uppercase tracking-wider transition-all duration-300 flex items-center justify-center gap-2 ${
                        isPopular
                          ? 'bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-500 hover:to-blue-500 text-white shadow-glow-sm hover:shadow-glow-md'
                          : 'bg-zinc-800/90 hover:bg-indigo-600 hover:text-white text-zinc-200 border border-zinc-700/60'
                      }`}
                    >
                      <span>Contratar Paquete</span>
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                    </button>
                    <p class="text-[10px] text-zinc-400 text-center mt-2.5">
                      🔒 Pago 100% protegido con Mercado Pago
                    </p>
                  </div>

                </div>
              );
            })}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  // Tab Switching Logic
  const tabs = document.querySelectorAll<HTMLButtonElement>('.category-tab');
  const panels = document.querySelectorAll<HTMLElement>('.service-panel');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const slug = tab.getAttribute('data-service-tab');
      if (!slug) return;

      // Update Tab Styles
      tabs.forEach(t => {
        t.classList.remove('bg-indigo-600', 'border-indigo-500', 'text-white', 'shadow-glow-sm');
        t.classList.add('bg-dark-card/60', 'border-zinc-800', 'text-zinc-400');
      });
      tab.classList.remove('bg-dark-card/60', 'border-zinc-800', 'text-zinc-400');
      tab.classList.add('bg-indigo-600', 'border-indigo-500', 'text-white', 'shadow-glow-sm');

      // Update Panel Visibility
      panels.forEach(p => {
        if (p.id === `service-panel-${slug}`) {
          p.classList.remove('hidden');
          p.classList.add('block');
        } else {
          p.classList.add('hidden');
          p.classList.remove('block');
        }
      });
    });
  });
</script>
