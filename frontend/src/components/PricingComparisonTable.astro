---
---

<section id="comparativa" class="py-16 md:py-20 bg-white border-b-2 border-zinc-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-12 space-y-3">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-indigo-50 border-2 border-zinc-900 text-xs font-black text-indigo-700 uppercase tracking-widest shadow-brutal-sm">
        <span>⚖️</span> Comparativa Detallada
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-zinc-900 font-display tracking-tight">
        ¿Qué paquete se adapta mejor a tu meta?
      </h2>
      <p class="text-sm sm:text-base text-zinc-600 font-medium">
        Transparencia absoluta: compara las especificaciones técnicas y alcance de cada solución antes de tomar una decisión.
      </p>
    </div>

    <!-- Mobile Horizontal Scroll Hint -->
    <div class="block md:hidden text-center mb-3">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-zinc-100 border border-zinc-300 text-[11px] font-extrabold text-zinc-700 shadow-sm animate-pulse">
        <span>↔</span> Desliza horizontalmente para comparar planes
      </span>
    </div>

    <!-- Comparison Table Container -->
    <div class="overflow-x-auto rounded-3xl border-3 border-zinc-900 shadow-brutal-lg bg-zinc-50 -mx-2 sm:mx-0">
      <table class="w-full text-left border-collapse min-w-[700px]">
        <thead>
          <tr class="border-b-3 border-zinc-900 bg-white">
            <th class="p-5 text-sm font-extrabold uppercase tracking-wider text-zinc-500 w-1/4">
              Especificación
            </th>
            <th class="p-5 text-center w-1/4 border-l-2 border-zinc-900 bg-zinc-50">
              <span class="text-xs uppercase font-extrabold tracking-widest text-zinc-600 block">Plan Rápido</span>
              <span class="text-lg font-black text-zinc-900 font-display block">Landing Page</span>
              <span class="text-xs font-bold text-indigo-600">Desde S/. 799 + IGV</span>
            </th>
            <th class="p-5 text-center w-1/4 border-l-2 border-zinc-900 bg-indigo-50/80 relative">
              <span class="absolute -top-3 left-1/2 -translate-x-1/2 px-2.5 py-0.5 rounded-full bg-zinc-900 text-amber-300 text-[10px] font-black uppercase tracking-wider border border-zinc-900 shadow-brutal-sm">
                Más Elegido ⭐
              </span>
              <span class="text-xs uppercase font-extrabold tracking-widest text-indigo-900 block mt-1">Plan Completo</span>
              <span class="text-lg font-black text-zinc-900 font-display block">Web Corporativa</span>
              <span class="text-xs font-bold text-indigo-700">Desde S/. 1,500 + IGV</span>
            </th>
            <th class="p-5 text-center w-1/4 border-l-2 border-zinc-900 bg-zinc-50">
              <span class="text-xs uppercase font-extrabold tracking-widest text-zinc-600 block">Plan Escalable</span>
              <span class="text-lg font-black text-zinc-900 font-display block">E-Commerce / Custom</span>
              <span class="text-xs font-bold text-indigo-600">Desde S/. 2,500 + IGV</span>
            </th>
          </tr>
        </thead>
        <tbody class="divide-y-2 divide-zinc-200 text-xs sm:text-sm font-medium text-zinc-800">
          
          <tr class="hover:bg-zinc-100/60 transition-colors">
            <td class="p-4 font-bold text-zinc-900">Dominio (.com / .pe) y Hosting 1er año</td>
            <td class="p-4 text-center border-l-2 border-zinc-200"><span class="text-emerald-600 font-black text-base">✓ Incluido</span></td>
            <td class="p-4 text-center border-l-2 border-zinc-200 bg-indigo-50/30"><span class="text-emerald-600 font-black text-base">✓ Incluido</span></td>
            <td class="p-4 text-center border-l-2 border-zinc-200"><span class="text-emerald-600 font-black text-base">✓ Incluido</span></td>
          </tr>

          <tr class="hover:bg-zinc-100/60 transition-colors">
            <td class="p-4 font-bold text-zinc-900">Estructura y Páginas</td>
            <td class="p-4 text-center border-l-2 border-zinc-200">1 Página One-Page (Secciones)</td>
            <td class="p-4 text-center border-l-2 border-zinc-200 bg-indigo-50/30 font-bold text-indigo-950">Hasta 5 a 7 páginas internas</td>
            <td class="p-4 text-center border-l-2 border-zinc-200">Ilimitadas / Catálogo de Productos</td>
          </tr>

          <tr class="hover:bg-zinc-100/60 transition-colors">
            <td class="p-4 font-bold text-zinc-900">Rendimiento Core Web Vitals (90+ PageSpeed)</td>
            <td class="p-4 text-center border-l-2 border-zinc-200"><span class="text-emerald-600 font-black text-base">✓</span></td>
            <td class="p-4 text-center border-l-2 border-zinc-200 bg-indigo-50/30"><span class="text-emerald-600 font-black text-base">✓</span></td>
            <td class="p-4 text-center border-l-2 border-zinc-200"><span class="text-emerald-600 font-black text-base">✓</span></td>
          </tr>

          <tr class="hover:bg-zinc-100/60 transition-colors">
            <td class="p-4 font-bold text-zinc-900">Pasarela de Pagos (Mercado Pago, Yape, Plin)</td>
            <td class="p-4 text-center border-l-2 border-zinc-200 text-zinc-400 font-semibold">— (Opcional)</td>
            <td class="p-4 text-center border-l-2 border-zinc-200 bg-indigo-50/30 text-zinc-400 font-semibold">— (Opcional)</td>
            <td class="p-4 text-center border-l-2 border-zinc-200"><span class="text-emerald-600 font-black text-base">✓ Incluida</span></td>
          </tr>

          <tr class="hover:bg-zinc-100/60 transition-colors">
            <td class="p-4 font-bold text-zinc-900">Chatbot de IA entrenado para tu negocio</td>
            <td class="p-4 text-center border-l-2 border-zinc-200 text-zinc-400 font-semibold">—</td>
            <td class="p-4 text-center border-l-2 border-zinc-200 bg-indigo-50/30 text-zinc-600">Add-on opcional</td>
            <td class="p-4 text-center border-l-2 border-zinc-200"><span class="text-emerald-600 font-black text-base">✓ Configuración Inicial</span></td>
          </tr>

          <tr class="hover:bg-zinc-100/60 transition-colors">
            <td class="p-4 font-bold text-zinc-900">Panel Autoadministrable para editar contenidos</td>
            <td class="p-4 text-center border-l-2 border-zinc-200 text-zinc-400 font-semibold">—</td>
            <td class="p-4 text-center border-l-2 border-zinc-200 bg-indigo-50/30"><span class="text-emerald-600 font-black text-base">✓ Incluido</span></td>
            <td class="p-4 text-center border-l-2 border-zinc-200"><span class="text-emerald-600 font-black text-base">✓ Incluido</span></td>
          </tr>

          <tr class="hover:bg-zinc-100/60 transition-colors">
            <td class="p-4 font-bold text-zinc-900">Soporte Técnico &amp; Garantía de Estabilidad</td>
            <td class="p-4 text-center border-l-2 border-zinc-200 font-bold">30 Días</td>
            <td class="p-4 text-center border-l-2 border-zinc-200 bg-indigo-50/30 font-black text-emerald-700">60 Días Garantizados</td>
            <td class="p-4 text-center border-l-2 border-zinc-200 font-bold">90 Días Garantizados</td>
          </tr>

          <tr class="hover:bg-zinc-100/60 transition-colors">
            <td class="p-4 font-bold text-zinc-900">Plazo de entrega pactado</td>
            <td class="p-4 text-center border-l-2 border-zinc-200 font-bold">7 días hábiles</td>
            <td class="p-4 text-center border-l-2 border-zinc-200 bg-indigo-50/30 font-bold text-indigo-900">14 días hábiles</td>
            <td class="p-4 text-center border-l-2 border-zinc-200 font-bold">20 a 30 días</td>
          </tr>

          <tr class="bg-white">
            <td class="p-5 font-bold text-zinc-900">Acción</td>
            <td class="p-5 text-center border-l-2 border-zinc-200">
              <a 
                href="#servicios" 
                class="inline-block py-2.5 px-4 rounded-full text-xs font-extrabold uppercase tracking-wider bg-zinc-900 text-white hover:bg-indigo-600 border-2 border-zinc-900 shadow-brutal-sm transition-all"
              >
                Ver Paquetes
              </a>
            </td>
            <td class="p-5 text-center border-l-2 border-zinc-200 bg-indigo-50/50">
              <a 
                href="#servicios" 
                class="inline-block py-2.5 px-4 rounded-full text-xs font-extrabold uppercase tracking-wider bg-indigo-600 text-white hover:bg-zinc-900 border-2 border-zinc-900 shadow-brutal-sm hover:shadow-brutal transition-all"
              >
                Elegir Corporativo
              </a>
            </td>
            <td class="p-5 text-center border-l-2 border-zinc-200">
              <button 
                type="button"
                data-open-booking-modal
                class="inline-block py-2.5 px-4 rounded-full text-xs font-extrabold uppercase tracking-wider bg-zinc-900 text-white hover:bg-emerald-600 border-2 border-zinc-900 shadow-brutal-sm transition-all"
              >
                Cotizar a Medida
              </button>
            </td>
          </tr>

        </tbody>
      </table>
    </div>

  </div>
</section>
