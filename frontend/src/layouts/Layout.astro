---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CheckoutModal from '../components/CheckoutModal.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
}

const {
  title = "MolinazDev — Desarrollo Web, Chatbots IA y Software en Lima",
  description = "Diseño de páginas web, chatbots con IA y automatizaciones a medida en Lima y para todo el mundo. Precios transparentes y cobro seguro por Mercado Pago.",
  canonicalPath = Astro.url.pathname
} = Astro.props;

const siteUrl = 'https://molinazdev.lat';
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const socialImageUrl = new URL('/og-image.svg', siteUrl).toString();
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="MolinazDev" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="MolinazDev — Desarrollo digital para negocios" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-paper text-ink min-h-screen flex flex-col font-sans antialiased overflow-x-hidden selection:bg-acid selection:text-ink">
    <Navbar />
    
    <main class="flex-1">
      <slot />
    </main>

    <Footer />
    <CheckoutModal />
  </body>
</html>
