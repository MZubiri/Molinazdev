---
import Layout from '../../layouts/Layout.astro';
import { getDefaultCatalog, type ServiceCatalog } from '../../lib/api';

export function getStaticPaths() {
  const services = getDefaultCatalog();
  return services.map(service => ({
    params: { slug: service.slug },
    props: { service }
  }));
}

interface Props {
  service: ServiceCatalog;
}

const { service } = Astro.props;
---

<Layout title={`${service.title} — MolinazDev`} description={service.description || ''}>
  <!-- Hero Section for Service -->
  <section class="pt-12 pb-16 md:pt-20 md:pb-24 border-b-2 border-ink bg-paper-subtle">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <a href="/#servicios" class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-ink/70 hover:text-brand transition-colors mb-2">
          <span>&larr;</span> Volver al catálogo
        </a>
        <div class="inline-block px-3 py-1 rounded-full bg-acid border-2 border-ink text-xs font-extrabold uppercase tracking-wider text-ink shadow-brutal-sm">
          Servicio Especializado
        </div>
        <h1 class="text-4xl sm:text-6xl font-extrabold text-ink font-display tracking-tight leading-tight">
          {service.title}
        </h1>
        {service.description && (
          <p class="text-base sm:text-lg text-ink/80 leading-relaxed font-medium">
            {service.description}
          </p>
        )}
      </div>
    </div>
  </section>

  <!-- Packages Section -->
  <section class="py-20 bg-paper">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-12 space-y-2">
        <span class="text-xs font-extrabold tracking-widest text-ink/60 uppercase block">Opciones disponibles</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-ink font-display">Paquetes para {service.title}</h2>
      </div>

      <div class={`grid gap-8 ${service.packages.length === 3 ? 'grid-cols-1 md:grid-cols-3' : 'grid-cols-1 md:grid-cols-2 max-w-4xl'}`}>
        {service.packages.map((pkg, index) => {
          const isHighlight = index === 1 || service.packages.length === 1;
          return (
            <div 
              class={`card-brutal p-8 flex flex-col justify-between relative bg-white ${
                isHighlight ? 'ring-2 ring-ink ring-offset-2' : ''
              }`}
            >
              <div>
                {isHighlight && (
                  <span class="inline-block px-3 py-0.5 rounded-full bg-acid border-2 border-ink text-ink text-[11px] font-extrabold uppercase tracking-wider mb-4 shadow-brutal-sm">
                    ★ Recomendado
                  </span>
                )}
                <h3 class="text-2xl font-extrabold text-ink font-display">{pkg.name}</h3>
                {pkg.description && (
                  <p class="text-xs text-ink/70 mt-2 font-medium leading-relaxed">{pkg.description}</p>
                )}

                <div class="mt-6 pt-6 border-t-2 border-ink/10">
                  <div class="flex items-baseline gap-1.5">
                    <span class="text-xs font-bold text-ink/60">{pkg.currency}</span>
                    <span class="text-3xl sm:text-4xl font-extrabold text-ink font-display tracking-tight">
                      {pkg.price.toLocaleString('es-PE', { minimumFractionDigits: 2 })}
                    </span>
                  </div>
                  <div class="inline-flex items-center gap-1.5 mt-2 text-xs font-bold text-ink bg-paper-subtle px-3 py-1 rounded-full border border-ink/30">
                    <span>⏱️ Entrega estimada: ~{pkg.deliveryDays} días hábiles</span>
                  </div>
                </div>

                <div class="mt-8 space-y-3">
                  <span class="text-xs font-extrabold uppercase tracking-wider text-ink/70 block">Entregables y funciones:</span>
                  <ul class="space-y-2.5">
                    {pkg.features.map(f => (
                      <li class="flex items-start gap-2.5 text-xs sm:text-sm text-ink/90 font-medium">
                        <span class="text-emerald-600 font-extrabold text-base leading-none">✓</span>
                        <span>{f}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <div class="mt-8 pt-6 border-t-2 border-ink/10">
                <button
                  type="button"
                  data-open-checkout
                  data-package-id={pkg.id}
                  data-package-name={pkg.name}
                  data-package-price={`${pkg.currency} ${pkg.price.toLocaleString('es-PE', { minimumFractionDigits: 2 })}`}
                  data-service-title={service.title}
                  class={`w-full py-4 px-6 text-xs sm:text-sm uppercase tracking-wider font-extrabold flex items-center justify-center gap-2 ${
                    isHighlight ? 'btn-brutal-acid' : 'btn-brutal-primary'
                  }`}
                >
                  <span>Contratar {pkg.name}</span>
                  <span class="font-bold">↗</span>
                </button>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
</Layout>
