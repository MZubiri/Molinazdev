@{
    ViewData["Title"] = "Pago recibido";
}

<section class="page-section compact-section">
    <div class="container narrow-container status-card status-success">
        <span class="status-symbol" aria-hidden="true">✓</span>
        <span class="eyebrow">Retorno de Mercado Pago</span>
        <h1>Gracias por tu compra</h1>
        <p>Mercado Pago nos está notificando el resultado. Confirmaremos la orden únicamente después de verificar el pago de forma segura.</p>
        <p class="status-detail">Si el pago fue aprobado, nos comunicaremos contigo usando los datos de tu orden.</p>
        <a class="button button-primary" asp-controller="Home" asp-action="Index">Volver al inicio</a>
    </div>
</section>
